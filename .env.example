EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
EXPO_PUBLIC_API_BASE_URL=https://subscription-control.oberndt.de

# OneSignal Push Notifications
# App-ID aus dem OneSignal-Dashboard (Settings > Keys & IDs)
EXPO_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
# REST-API-Key zum Senden von Pushes. ACHTUNG: landet im Web-Bundle (öffentlich).
# Produktiv sollte der Versand über ein Backend laufen.
EXPO_PUBLIC_ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
# OneSignal Web-SDK aktivieren (Default aus). Nur auf true setzen, wenn im
# Dashboard eine Web-Plattform mit passender Site-URL eingerichtet ist.
# Im Web laufen Erinnerungen sonst über lokale Browser-Benachrichtigungen.
EXPO_PUBLIC_ONESIGNAL_WEB_ENABLED=false
